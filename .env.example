# FableFlow environment variables.
# The LLM client uses OpenAI's wire format and points at any compatible server
# (vLLM, Ollama, llama.cpp's `server`, hosted Anthropic/OpenAI-compatible proxies, etc.).

# vLLM running locally — most common setup:
export MODEL_SERVER_URL="http://0.0.0.0:8000/v1"
export MODEL_API_KEY="dev-api-key"
export DEFAULT_MODEL="google/gemma-4-31B-it"

# Hosted alternative example:
# export MODEL_SERVER_URL="https://api.anthropic.com/v1"
# export MODEL_API_KEY="sk-ant-..."
# export DEFAULT_MODEL="claude-sonnet-4-5"
